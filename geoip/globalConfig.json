{
    "pages": {
        "configuration": {
            "tabs": [
                {
                    "name": "account",
                    "entity": [
                        {
                            "type": "text",
                            "label": "Account ID",
                            "field": "account_id",
                            "help": "Your MaxMind Account ID (found in your MaxMind account portal).",
                            "required": true,
                            "encrypted": true,
                            "validators": [
                                {
                                    "type": "regex",
                                    "errorMsg": "Account ID must be a numeric value.",
                                    "pattern": "^[0-9]+$"
                                },
                                {
                                    "type": "string",
                                    "errorMsg": "Length of Account ID should be between 1 and 20",
                                    "minLength": 1,
                                    "maxLength": 20
                                }
                            ]
                        },
                        {
                            "type": "text",
                            "label": "License Key",
                            "field": "license_key",
                            "help": "Your MaxMind License Key (generate in your MaxMind account under 'Manage License Keys').",
                            "required": true,
                            "encrypted": true,
                            "validators": [
                                {
                                    "type": "regex",
                                    "errorMsg": "License Key can only contain letters, numbers, and underscores.",
                                    "pattern": "^[A-Za-z0-9_]+$"
                                },
                                {
                                    "type": "string",
                                    "errorMsg": "Length of License Key should be between 8 and 100",
                                    "minLength": 8,
                                    "maxLength": 100
                                }
                            ]
                        }
                    ],
                    "title": "MaxMind Account"
                },
                {
                    "name": "databases",
                    "title": "Databases",
                    "table": {
                        "header": [
                            {
                                "label": "Database Name",
                                "field": "name"
                            }
                        ],
                        "actions": [
                            "edit",
                            "delete"
                        ]
                    },
                    "entity": [
                        {
                            "type": "text",
                            "label": "Database Name",
                            "field": "name",
                            "required": true,
                            "help": "MaxMind database name (e.g., GeoIP2-City, GeoIP2-Anonymous-IP)",
                            "validators": [
                                {
                                    "type": "regex",
                                    "errorMsg": "Database name can only contain letters, numbers, and hyphens.",
                                    "pattern": "^[A-Za-z0-9-]+$"
                                }
                            ]
                        }
                    ],
                    "restHandlerModule": "geoip_handler",
                    "restHandlerClass": "GeoipDatabasesHandler"
                },
                {
                    "name": "distribution",
                    "title": "Distributed Search",
                    "entity": [
                        {
                            "type": "checkbox",
                            "label": "Run on indexers",
                            "field": "run_on_indexers",
                            "help": "Run the geoip command on the indexers and replicate the MaxMind databases to them in the knowledge bundle. Off by default: large databases increase the knowledge bundle size, and replication can exceed bundle size limits. Restart the search head (every member, in a search head cluster) after changing this setting - the change to database replication only takes effect at startup. After the restart, the databases reach the indexers with the next knowledge bundle push, typically within a couple of minutes; in a distributed deployment, geoip searches fail with a database-not-found error after enabling until that push completes.",
                            "defaultValue": 0
                        }
                    ]
                },
                {
                    "type": "loggingTab"
                }
            ],
            "title": "Configuration",
            "description": "Configure your MaxMind account and databases"
        }
    },
    "meta": {
        "name": "geoip",
        "restRoot": "geoip",
        "version": "1.3.0",
        "displayName": "MaxMind GeoIP App",
        "schemaVersion": "0.0.10",
        "supportedThemes": [
            "light",
            "dark"
        ],
        "supportedPythonVersion": [
            "3.13"
        ]
    },
    "customSearchCommand": [
        {
            "commandName": "geoip",
            "fileName": "geoip_command.py",
            "commandType": "streaming",
            "requiredSearchAssistant": true,
            "description": "Adds MaxMind GeoIP and GeoLite data to events by looking up the IP address in each event. The field option names the event field with the IP address (default ip), and prefix sets a prefix for the output field names. Quote the databases value when it lists more than one database.",
            "shortdesc": "Adds MaxMind GeoIP and GeoLite data to events.",
            "syntax": "geoip (prefix=<string>)? (field=<field>)? databases=<string>",
            "usage": "public",
            "tags": "maxmind geoip geolite ip",
            "examples": [
                {
                    "search": "... | geoip databases=GeoIP2-Country",
                    "comment": "Look up the IP address in the ip field."
                },
                {
                    "search": "... | geoip prefix=geo_ field=client_ip databases=\"GeoIP2-City,GeoIP2-Anonymous-IP\"",
                    "comment": "Look up the client_ip field in two databases, and prefix the output fields with geo_. Quote the list."
                }
            ],
            "arguments": [
                {
                    "name": "field",
                    "validate": {
                        "type": "Fieldname"
                    },
                    "required": false,
                    "defaultValue": "ip"
                },
                {
                    "name": "prefix",
                    "required": false,
                    "defaultValue": ""
                },
                {
                    "name": "databases",
                    "required": true
                }
            ]
        },
        {
            "commandName": "geoipdebug",
            "fileName": "geoipdebug_command.py",
            "commandType": "generating",
            "requiredSearchAssistant": true,
            "description": "Reports the status of each configured GeoIP database, plus the app, Splunk, and Python versions and the app settings. Run it when you contact support. With indexers=true, it runs on the search head and on each search peer.",
            "shortdesc": "Reports GeoIP database and app diagnostics.",
            "syntax": "geoipdebug (indexers=<bool>)?",
            "usage": "public",
            "tags": "maxmind geoip geolite diagnostic",
            "examples": [
                {
                    "search": "| geoipdebug",
                    "comment": "Report diagnostics from the search head."
                },
                {
                    "search": "| geoipdebug indexers=true",
                    "comment": "Also run on each search peer and report its database copies."
                }
            ],
            "arguments": [
                {
                    "name": "indexers",
                    "validate": {
                        "type": "Boolean"
                    },
                    "required": false,
                    "defaultValue": "false"
                }
            ]
        }
    ]
}
